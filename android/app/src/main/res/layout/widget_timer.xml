<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="10dp" android:background="@drawable/widget_bg">
    <LinearLayout android:id="@+id/t_tap" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="vertical" android:gravity="center">
        <Chronometer android:id="@+id/t_chrono" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#16A34A" android:textSize="34sp" android:textStyle="bold" android:fontFamily="monospace" android:visibility="gone" />
        <TextView android:id="@+id/t_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00"
            android:textColor="#17171F" android:textSize="34sp" android:textStyle="bold" android:fontFamily="monospace" />
        <TextView android:id="@+id/t_hint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Başlatmak için dokun"
            android:textColor="#5B6176" android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/t_stats" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#5B6176" android:textSize="11sp" android:maxLines="1" />
        <TextView android:id="@+id/t_json" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="6dp" android:text="JSON"
            android:textColor="#2563EB" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/t_reset" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="6dp" android:text="Sıfırla"
            android:textColor="#DC2626" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
