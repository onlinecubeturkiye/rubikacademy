rules_version = '2';
// Rubik Academy — Firestore güvenlik kuralları
//  days/{gün}/times/{uid} : Günün karıştırması sıralaması (hesaba bağlı). Herkes okur;
//        sahibi günde bir kez yazar (varsa tekrar yazamaz); admin ya da sahibi siler.
//  users/{uid}            : Herkese açık profil (ad, foto, bio, özet). Sahibi yazar.
//  users/{uid}/kv/{a}     : İlerleme/trainer/günlük senkronu. Sahibi + admin okur; sahibi yazar.
//  users/{uid}/visits/{v} : Sayfa ziyaret kaydı (admin paneli için). Sahibi ekler; admin + sahibi okur.
//  transfer/{id}          : Cihazlar arası geçici şifreli aktarım.
//  Admin: pikapikachuyt0@gmail.com (Google ile giriş).
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'pikapikachuyt0@gmail.com'
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // Askıya alınmış hesap (roles/{uid}.role == 'askida') yazamaz
    function suspended(uid) {
      return exists(/databases/$(database)/documents/roles/$(uid))
        && get(/databases/$(database)/documents/roles/$(uid)).data.role in ['askida', 'silindi'];
    }

    match /days/{day}/times/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid && !suspended(uid)
        && day.matches('^[0-9]{5}$')
        && int(day) - math.floor(request.time.toMillis() / 86400000) <= 1
        && math.floor(request.time.toMillis() / 86400000) - int(day) <= 1
        && request.resource.data.keys().hasOnly(['name', 't', 'pen', 'v', 'ts'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 20
        && request.resource.data.t is int
        && request.resource.data.t >= 3000 && request.resource.data.t <= 3600000
        && request.resource.data.pen in ['', '+2', 'dnf']
        && request.resource.data.v == (request.resource.data.pen == 'dnf' ? 99999999
             : request.resource.data.t + (request.resource.data.pen == '+2' ? 2000 : 0))
        && request.resource.data.ts == request.time;
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow update: if false;
    }

    match /users/{uid} {
      allow get: if true;               // profil linkle paylaşılabilir (tekil okuma herkese açık)
      allow list: if isAdmin();         // tüm kullanıcıları yalnız admin listeler
      allow create, update: if (request.auth != null && request.auth.uid == uid) && !suspended(uid)
        && request.resource.data.keys().hasOnly(['name', 'photo', 'bio', 'joined', 'seen', 'stats'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string && request.resource.data.photo.size() <= 40000))
        && (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 160))
        && (!('stats' in request.resource.data) || (request.resource.data.stats is string && request.resource.data.stats.size() <= 8000));
      allow delete: if (request.auth != null && request.auth.uid == uid) || isAdmin();

      match /kv/{key} {
        allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
        allow delete: if (request.auth != null && request.auth.uid == uid) || isAdmin();
        // Sahibi yazar; admin de düzenleyebilir (admin paneli veri düzenleyicisi)
        allow create, update: if ((request.auth != null && request.auth.uid == uid) || isAdmin())
          && key.matches('^[a-z0-9-]{1,64}$')
          && request.resource.data.keys().hasOnly(['v', 't'])
          && request.resource.data.v is string && request.resource.data.v.size() <= 500000
          && request.resource.data.t is int;
      }

      match /visits/{vid} {
        allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['p', 'ts'])
          && request.resource.data.p is string && request.resource.data.p.size() <= 120
          && request.resource.data.ts is timestamp;
        allow update: if isAdmin();
        allow delete: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      }

      // Oturumlar (cihaz geçmişi + "tüm cihazlardan çık"): sahibi yazar/okur; admin okur
      match /sessions/{sid} {
        allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
        allow create, update: if request.auth != null && request.auth.uid == uid;
        allow delete: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      }
      // Bildirimler: yalnız admin gönderir; sahibi + admin okur
      match /notifications/{nid} {
        allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(['text', 'ts', 'at', 'pushed'])
          && request.resource.data.text is string && request.resource.data.text.size() <= 500;
        allow update, delete: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      }
      // Özel üye bilgisi (e-posta, giriş türü, tema, dil, işaretler) — herkese açık DEĞİL
      match /meta/{m} {
        allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['email', 'provider', 'name', 'theme', 'cvd', 'skin', 'lang', 'seen', 'dev', 'marks'])
          && request.resource.data.email is string && request.resource.data.email.size() <= 120
          && (!('marks' in request.resource.data) || (request.resource.data.marks is string && request.resource.data.marks.size() <= 40000));
        allow delete: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      }
    }

    match /transfer/{id} {
      allow get: if resource.data.exp > request.time;
      allow list, update: if false;
      allow create: if id.matches('^[a-f0-9]{32}$')
        && request.resource.data.keys().hasOnly(['d', 'iv', 'exp'])
        && request.resource.data.d is string && request.resource.data.d.size() <= 900000
        && request.resource.data.iv is string && request.resource.data.iv.size() <= 40
        && request.resource.data.exp is timestamp
        && request.resource.data.exp > request.time
        && request.resource.data.exp <= request.time + duration.value(90, 's');
      allow delete: if id.matches('^[a-f0-9]{32}$');
    }

    // Admin paneli: tüm kullanıcıları ve alt koleksiyonlarını listeleyip okuyabilir
    // Roller: herkes okur (profil rozeti), yalnızca admin yazar
    match /roles/{uid} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['role'])
        && request.resource.data.role in ['uye', 'gelistirici', 'tester', 'organizator', 'askida', 'silindi'];
      // Hesabını silen üye kendi rol kaydını da siler (askıya alınmış / silinmişse silemez)
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid && !(resource.data.role in ['askida', 'silindi']));
    }

    // Admin'in sildiği hesaplar: Firebase giriş hesabını GitHub Actions'taki görev siler, sonra kaydı kaldırır
    match /deletions/{uid} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['ts', 'name'])
        && request.resource.data.ts is timestamp;
    }

    // Ev yarışması (/icerikler/ev-yarismasi): 8-16 kişi, 3x3 ya da 2x2, turlar Ao5. Herkes izler/katılır; organizatör, geliştirici ya da admin kurar.
    match /comps/{code} {
      // Herkese açık: giriş yapan (askıya alınmamış) her üye katılır
      function beta() { return request.auth != null && !suspended(request.auth.uid); }
      function compDoc() { return get(/databases/$(database)/documents/comps/$(code)).data; }
      function org() {
        return request.auth != null && (isAdmin()
          || (exists(/databases/$(database)/documents/roles/$(request.auth.uid))
              && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role in ['organizator', 'gelistirici']));
      }
      function ck() { return ['host', 'hName', 'name', 'cap', 'ev', 'round', 'fin', 'st', 'scr', 'adv', 'R', 'ts', 'mods', 'ban', 'pa']; }
      // Moderatör: oda sahibinin atadığı kişiler (mods = virgülle uid listesi)
      function isModOf(d) { return request.auth != null && ('mods' in d) && d.mods.split(',').hasAny([request.auth.uid]); }
      function chgC() { return request.resource.data.diff(resource.data).affectedKeys(); }
      allow get, list: if true;
      allow create: if org() && code.matches('^[A-Z0-9]{5}$')
        && request.resource.data.keys().hasOnly(ck())
        && request.resource.data.host == request.auth.uid
        && request.resource.data.cap is int && request.resource.data.cap >= 8 && request.resource.data.cap <= 16
        && request.resource.data.ev in ['333', '222']
        && request.resource.data.name is string && request.resource.data.name.size() <= 40;
      // Sahip/admin her şeyi değiştirir (devretme ve moderatör atama dahil); moderatör yalnız tur alanlarını
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.host || isAdmin()
            || (isModOf(resource.data) && !chgC().hasAny(['host', 'hName', 'mods', 'cap', 'name'])))
        && request.resource.data.keys().hasOnly(ck())
        && request.resource.data.host is string && request.resource.data.host.size() > 0
        && (!('mods' in request.resource.data) || request.resource.data.mods.size() <= 600)
        && (!('ban' in request.resource.data) || request.resource.data.ban.size() <= 1500)
        && request.resource.data.cap is int && request.resource.data.cap >= 8 && request.resource.data.cap <= 16
        && request.resource.data.R is string && request.resource.data.R.size() <= 200000
        && request.resource.data.scr is string && request.resource.data.scr.size() <= 1500;
      // Sahip/admin her zaman; diğer üyeler yalnız 15 dakikadır değişmeyen (boş kalmış) odayı silebilir
      allow delete: if request.auth != null && (request.auth.uid == resource.data.host || isAdmin()
        || (beta() && resource.data.ts is timestamp && resource.data.ts < request.time - duration.value(15, 'm')));

      // Yarışmacılar: herkes kendi kaydını yazar; oda sahibi ya da moderatör çıkarabilir
      match /p/{uid} {
        allow read: if true;
        // kendisi yazar (çıkarılmadıysa); oda sahibi / moderatör / admin süre dolunca DNF yazabilir
        allow create, update: if beta()
          && ((request.auth.uid == uid && !compDoc().get('ban', '').split(',').hasAny([uid]))
              || (resource != null && (isAdmin() || compDoc().host == request.auth.uid || isModOf(compDoc()))
                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['t', 'tt', 'rnd', 'ts'])))
          && request.resource.data.keys().hasOnly(['name', 'mode', 't', 'tt', 'rnd', 'ts'])
          && (!('tt' in request.resource.data) || (request.resource.data.tt is string && request.resource.data.tt.size() <= 200))
          && request.resource.data.name is string && request.resource.data.name.size() <= 24
          && request.resource.data.mode in ['bt', 'timer', 'manual']
          && request.resource.data.t is string && request.resource.data.t.size() <= 120;
        allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin()
          || compDoc().host == request.auth.uid || isModOf(compDoc()));
      }

      // Mini sohbet: yalnız yarışmacılar, oda sahibi ve moderatörler yazar (izleyiciler yazamaz)
      match /m/{mid} {
        allow read: if true;
        allow create: if beta() && mid.matches('^[a-z0-9]{6,24}$')
          && (isAdmin() || compDoc().host == request.auth.uid || isModOf(compDoc())
              || exists(/databases/$(database)/documents/comps/$(code)/p/$(request.auth.uid)))
          && request.resource.data.keys().hasOnly(['u', 'n', 'x', 'ts'])
          && request.resource.data.u == request.auth.uid
          && request.resource.data.n is string && request.resource.data.n.size() <= 24
          && request.resource.data.x is string && request.resource.data.x.size() > 0 && request.resource.data.x.size() <= 200
          && request.resource.data.ts is timestamp
          && request.resource.data.ts > request.time - duration.value(120, 's')
          && request.resource.data.ts < request.time + duration.value(120, 's');
        allow delete: if request.auth != null && (request.auth.uid == resource.data.u || isAdmin()
          || get(/databases/$(database)/documents/comps/$(code)).data.host == request.auth.uid
          || isModOf(get(/databases/$(database)/documents/comps/$(code)).data));
      }

      // Canlı izleyiciler: her sayfa 20 sn'de bir kendi kaydının zamanını yazar ("X kişi izliyor")
      match /w/{vid} {
        allow read: if true;
        allow create, update: if beta() && vid.matches('^[A-Za-z0-9_-]{6,40}$')
          && request.resource.data.keys().hasOnly(['ts'])
          && request.resource.data.ts is timestamp
          && request.resource.data.ts > request.time - duration.value(120, 's')
          && request.resource.data.ts < request.time + duration.value(120, 's');
        allow delete: if isAdmin() || (request.auth != null && (request.auth.uid == vid
          || get(/databases/$(database)/documents/comps/$(code)).data.host == request.auth.uid));
      }
    }

    // Rekor tablosu (/icerikler/rekorlar): ev yarışması kişisel rekorları. Herkes okur; sahibi yazar (ms, 0 = yok)
    match /records/{uid} {
      function okT(f) { return request.resource.data[f] is int && request.resource.data[f] >= 0 && request.resource.data[f] < 3600000; }
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid && !suspended(uid)
        && request.resource.data.keys().hasOnly(['name', 's333', 'a5_333', 'a12_333', 's222', 'a5_222', 'a12_222', 'n', 'w', 'ts'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && okT('s333') && okT('a5_333') && okT('a12_333') && okT('s222') && okT('a5_222') && okT('a12_222')
        && request.resource.data.n is int && request.resource.data.w is int
        && request.resource.data.ts is timestamp;
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
    }

    // Topluluk algoritmaları: algsug/{case}/s/{uid}. Herkes okur; her üye bir case'e tek öneri (belge = uid).
    // Oy: vs haritasına yalnız kendi uid'ini ekler / çıkarır.
    match /algsug/{cid}/s/{sid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == sid && !suspended(sid) && cid.size() <= 400
        && request.resource.data.keys().hasOnly(['a', 'u', 'n', 'ts', 'vs'])
        && request.resource.data.u == sid
        && request.resource.data.a is string && request.resource.data.a.size() >= 1 && request.resource.data.a.size() <= 200
        && request.resource.data.n is string && request.resource.data.n.size() <= 24
        && request.resource.data.ts is timestamp
        && request.resource.data.vs is map && request.resource.data.vs.keys().hasOnly([sid]);
      allow update: if request.auth != null && !suspended(request.auth.uid)
        && request.resource.data.keys().hasOnly(['a', 'u', 'n', 'ts', 'vs'])
        && (
          (request.auth.uid == sid && request.resource.data.u == sid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['a', 'n', 'ts', 'u'])
            && request.resource.data.a is string && request.resource.data.a.size() >= 1 && request.resource.data.a.size() <= 200
            && request.resource.data.n is string && request.resource.data.n.size() <= 24)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vs'])
            && request.resource.data.vs.diff(resource.data.vs).affectedKeys().hasOnly([request.auth.uid]))
        );
      allow delete: if request.auth != null && (request.auth.uid == sid || isAdmin());
    }

    // Site ayarı (bakım modu): herkes okur, yalnız admin yazar
    // Hesapsız ziyaretçiler: cihaz başına tek belge (oturumda bir kez yazılır); yalnız admin okur/siler
    match /anon/{vid} {
      allow read, delete: if isAdmin();
      allow create, update: if vid.matches('^v[a-z0-9]{6,20}$')
        && request.resource.data.keys().hasOnly(['f', 'l', 'd', 's', 'p', 'dev'])
        && request.resource.data.l is int
        && request.resource.data.l > request.time.toMillis() - 600000
        && request.resource.data.l < request.time.toMillis() + 600000
        && request.resource.data.f is int && request.resource.data.f <= request.resource.data.l
        && request.resource.data.d is int && request.resource.data.d >= 1 && request.resource.data.d <= 100000
        && request.resource.data.s is int && request.resource.data.s >= 1 && request.resource.data.s <= 1000000
        && request.resource.data.p is string && request.resource.data.p.size() <= 120
        && request.resource.data.dev is string && request.resource.data.dev.size() <= 40;
    }

    match /config/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Herkese açık duyurular: yalnız admin yazar, herkes okur
    match /broadcasts/{id} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['text', 'ts', 'at', 'pushed'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 500;
      allow update, delete: if isAdmin();
    }

    // Web Push abonelikleri: herkes kendi cihazını kaydeder (uid boş ya da kendisi); yalnız admin okur.
    // Gönderimi GitHub Actions'taki gönderici (hizmet hesabı) yapar.
    match /pushsubs/{id} {
      allow get, list: if isAdmin();
      allow delete: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create, update: if id.matches('^[a-f0-9]{32}$')
        && request.resource.data.keys().hasOnly(['sub', 'uid', 'rem', 'ts'])
        && (!('rem' in request.resource.data) || (request.resource.data.rem is string && request.resource.data.rem.size() <= 20))
        && request.resource.data.sub is string && request.resource.data.sub.size() <= 2000
        && request.resource.data.uid is string
        && (request.resource.data.uid == '' || (request.auth != null && request.auth.uid == request.resource.data.uid))
        && request.resource.data.ts is timestamp;
    }

    match /users/{uid}/{sub=**} {
      allow read: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
