rules_version = '2';
// Rubik Academy — Firestore güvenlik kuralları
//  days/{gün}/times/{uid} : Günün karıştırması sıralaması (hesaba bağlı). Herkes okur;
//        sahibi günde bir kez yazar (varsa tekrar yazamaz); admin ya da sahibi siler.
//  users/{uid}            : Herkese açık profil (ad, foto, bio, özet). Sahibi yazar.
//  users/{uid}/kv/{a}     : İlerleme/trainer/günlük senkronu. Sahibi + admin okur; sahibi yazar.
//  users/{uid}/visits/{v} : Sayfa ziyaret kaydı (admin paneli için). Sahibi ekler; admin + sahibi okur.
//  transfer/{id}          : Cihazlar arası geçici şifreli aktarım.
//  Admin: pikapikachuyt0@gmail.com (Google ile giriş).
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'pikapikachuyt0@gmail.com'
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // Çekiliş yöneticisi: site yöneticisi ya da "admin" / "gelistirici" rolü
    function gwMgr() {
      return request.auth != null && (isAdmin()
        || (exists(/databases/$(database)/documents/roles/$(request.auth.uid))
            && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role in ['admin', 'gelistirici']));
    }

    // Askıya alınmış hesap (roles/{uid}.role == 'askida') yazamaz
    function suspended(uid) {
      return exists(/databases/$(database)/documents/roles/$(uid))
        && get(/databases/$(database)/documents/roles/$(uid)).data.role in ['askida', 'silindi'];
    }

    match /days/{day}/times/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid && !suspended(uid)
        && day.matches('^[0-9]{5}$')
        && int(day) - math.floor(request.time.toMillis() / 86400000) <= 1
        && math.floor(request.time.toMillis() / 86400000) - int(day) <= 1
        && request.resource.data.keys().hasOnly(['name', 't', 'pen', 'v', 'ts'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 20
        && request.resource.data.t is int
        && request.resource.data.t >= 3000 && request.resource.data.t <= 3600000
        && request.resource.data.pen in ['', '+2', 'dnf']
        && request.resource.data.v == (request.resource.data.pen == 'dnf' ? 99999999
             : request.resource.data.t + (request.resource.data.pen == '+2' ? 2000 : 0))
        && request.resource.data.ts == request.time;
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow update: if false;
    }

    match /users/{uid} {
      allow get: if true;               // profil linkle paylaşılabilir (tekil okuma herkese açık)
      allow list: if isAdmin();         // tüm kullanıcıları yalnız admin listeler
      allow create, update: if (request.auth != null && request.auth.uid == uid) && !suspended(uid)
        && request.resource.data.keys().hasOnly(['name', 'photo', 'bio', 'joined', 'seen', 'stats'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string && request.resource.data.photo.size() <= 40000))
        && (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 160))
        && (!('stats' in request.resource.data) || (request.resource.data.stats is string && request.resource.data.stats.size() <= 8000));
      allow delete: if (request.auth != null && request.auth.uid == uid) || isAdmin();

      match /kv/{key} {
        allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
        allow delete: if (request.auth != null && request.auth.uid == uid) || isAdmin();
        // Sahibi yazar; admin de düzenleyebilir (admin paneli veri düzenleyicisi)
        allow create, update: if ((request.auth != null && request.auth.uid == uid) || isAdmin())
          && key.matches('^[a-z0-9-]{1,64}$')
          && request.resource.data.keys().hasOnly(['v', 't'])
          && request.resource.data.v is string && request.resource.data.v.size() <= 500000
          && request.resource.data.t is int;
      }

      match /visits/{vid} {
        allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['p', 'ts'])
          && request.resource.data.p is string && request.resource.data.p.size() <= 120
          && request.resource.data.ts is timestamp;
        allow update: if isAdmin();
        allow delete: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      }

      // Oturumlar (cihaz geçmişi + "tüm cihazlardan çık"): sahibi yazar/okur; admin okur
      match /sessions/{sid} {
        allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
        allow create, update: if request.auth != null && request.auth.uid == uid;
        allow delete: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      }
      // Bildirimler: yalnız admin gönderir; sahibi + admin okur
      match /notifications/{nid} {
        allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
        // Admin gönderir; çekiliş yöneticisi kazanana yazar; kazanan da bilgilerini gönderince çekilişi kurana
        // (belge adı = çekiliş kodu) tek bir bildirim yazabilir
        allow create: if (isAdmin() || gwMgr()
            || (exists(/databases/$(database)/documents/giveaways/$(nid))
                && get(/databases/$(database)/documents/giveaways/$(nid)).data.w == request.auth.uid
                && get(/databases/$(database)/documents/giveaways/$(nid)).data.host == uid))
          && request.resource.data.keys().hasOnly(['text', 'ts', 'at', 'pushed'])
          && request.resource.data.text is string && request.resource.data.text.size() <= 500;
        allow update, delete: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      }
      // Özel üye bilgisi (e-posta, giriş türü, tema, dil, işaretler) — herkese açık DEĞİL
      match /meta/{m} {
        allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['email', 'provider', 'name', 'theme', 'cvd', 'skin', 'lang', 'seen', 'dev', 'marks'])
          && request.resource.data.email is string && request.resource.data.email.size() <= 120
          && (!('marks' in request.resource.data) || (request.resource.data.marks is string && request.resource.data.marks.size() <= 40000));
        allow delete: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      }
    }

    match /transfer/{id} {
      allow get: if resource.data.exp > request.time;
      allow list, update: if false;
      allow create: if id.matches('^[a-f0-9]{32}$')
        && request.resource.data.keys().hasOnly(['d', 'iv', 'exp'])
        && request.resource.data.d is string && request.resource.data.d.size() <= 900000
        && request.resource.data.iv is string && request.resource.data.iv.size() <= 40
        && request.resource.data.exp is timestamp
        && request.resource.data.exp > request.time
        && request.resource.data.exp <= request.time + duration.value(90, 's');
      allow delete: if id.matches('^[a-f0-9]{32}$');
    }

    // Admin paneli: tüm kullanıcıları ve alt koleksiyonlarını listeleyip okuyabilir
    // Roller: herkes okur (profil rozeti), yalnızca admin yazar
    match /roles/{uid} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['role'])
        && request.resource.data.role in ['uye', 'admin', 'gelistirici', 'tester', 'organizator', 'askida', 'silindi'];
      // Hesabını silen üye kendi rol kaydını da siler (askıya alınmış / silinmişse silemez)
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid && !(resource.data.role in ['askida', 'silindi']));
    }

    // Admin'in sildiği hesaplar: Firebase giriş hesabını GitHub Actions'taki görev siler, sonra kaydı kaldırır
    match /deletions/{uid} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['ts', 'name'])
        && request.resource.data.ts is timestamp;
    }

    // Ev yarışması (/icerikler/ev-yarismasi): 8-16 kişi, 3x3 ya da 2x2, turlar Ao5. Herkes izler/katılır; organizatör, geliştirici ya da admin kurar.
    match /comps/{code} {
      // Herkese açık: giriş yapan (askıya alınmamış) her üye katılır
      function beta() { return request.auth != null && !suspended(request.auth.uid); }
      function compDoc() { return get(/databases/$(database)/documents/comps/$(code)).data; }
      function org() {
        return request.auth != null && (isAdmin()
          || (exists(/databases/$(database)/documents/roles/$(request.auth.uid))
              && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role in ['organizator', 'gelistirici']));
      }
      function ck() { return ['host', 'hName', 'name', 'cap', 'ev', 'round', 'fin', 'st', 'scr', 'adv', 'R', 'ts', 'mods', 'ban', 'pa', 'ok', 'okBy', 'okTs', 'okNote']; }
      // Onay (double check): ok = 1 onaylandı, -1 reddedildi; yalnız admin yazar. Onay/ret verilmiş odanın sonuçları (R) da yalnız admin'ce değişir.
      function okSafe() {
        return isAdmin() || (!chgC().hasAny(['ok', 'okBy', 'okTs', 'okNote']) && !(('ok' in resource.data) && chgC().hasAny(['R'])));
      }
      // Moderatör: oda sahibinin atadığı kişiler (mods = virgülle uid listesi)
      function isModOf(d) { return request.auth != null && ('mods' in d) && d.mods.split(',').hasAny([request.auth.uid]); }
      function chgC() { return request.resource.data.diff(resource.data).affectedKeys(); }
      allow get, list: if true;
      allow create: if org() && code.matches('^[A-Z0-9]{5}$')
        && request.resource.data.keys().hasOnly(ck())
        && !('ok' in request.resource.data) && !('okBy' in request.resource.data) && !('okTs' in request.resource.data) && !('okNote' in request.resource.data)
        && request.resource.data.host == request.auth.uid
        && request.resource.data.cap is int && request.resource.data.cap >= 8 && request.resource.data.cap <= 16
        && request.resource.data.ev in ['333', '222']
        && request.resource.data.name is string && request.resource.data.name.size() <= 40;
      // Sahip/admin her şeyi değiştirir (devretme ve moderatör atama dahil); moderatör yalnız tur alanlarını
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.host || isAdmin()
            || (isModOf(resource.data) && !chgC().hasAny(['host', 'hName', 'mods', 'cap', 'name'])))
        && okSafe()
        && request.resource.data.keys().hasOnly(ck())
        && (!('okNote' in request.resource.data) || (request.resource.data.okNote is string && request.resource.data.okNote.size() <= 300))
        && request.resource.data.host is string && request.resource.data.host.size() > 0
        && (!('mods' in request.resource.data) || request.resource.data.mods.size() <= 600)
        && (!('ban' in request.resource.data) || request.resource.data.ban.size() <= 1500)
        && request.resource.data.cap is int && request.resource.data.cap >= 8 && request.resource.data.cap <= 16
        && request.resource.data.R is string && request.resource.data.R.size() <= 200000
        && request.resource.data.scr is string && request.resource.data.scr.size() <= 1500;
      // Admin her zaman. Sonucu olan (en az bir tur bitmiş) oda onay için saklanır: yalnız admin siler.
      // Sonucu olmayan odayı sahip her zaman, diğer üyeler 15 dakikadır değişmiyorsa (boş kalmışsa) silebilir.
      allow delete: if request.auth != null && (isAdmin()
        || ((!('R' in resource.data) || resource.data.R == '[]')
          && (request.auth.uid == resource.data.host
            || (beta() && resource.data.ts is timestamp && resource.data.ts < request.time - duration.value(15, 'm')))));

      // Yarışmacılar: herkes kendi kaydını yazar; oda sahibi ya da moderatör çıkarabilir
      match /p/{uid} {
        allow read: if true;
        // kendisi yazar (çıkarılmadıysa); oda sahibi / moderatör / admin süre dolunca DNF yazabilir
        allow create, update: if beta()
          && ((request.auth.uid == uid && !compDoc().get('ban', '').split(',').hasAny([uid]))
              || (resource != null && (isAdmin() || compDoc().host == request.auth.uid || isModOf(compDoc()))
                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['t', 'tt', 'rnd', 'ts'])))
          && request.resource.data.keys().hasOnly(['name', 'mode', 't', 'tt', 'rnd', 'ts'])
          && (!('tt' in request.resource.data) || (request.resource.data.tt is string && request.resource.data.tt.size() <= 200))
          && request.resource.data.name is string && request.resource.data.name.size() <= 24
          && request.resource.data.mode in ['bt', 'timer', 'manual']
          && request.resource.data.t is string && request.resource.data.t.size() <= 120;
        allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin()
          || compDoc().host == request.auth.uid || isModOf(compDoc()));
      }

      // Mini sohbet: yalnız yarışmacılar, oda sahibi ve moderatörler yazar (izleyiciler yazamaz)
      match /m/{mid} {
        allow read: if true;
        allow create: if beta() && mid.matches('^[a-z0-9]{6,24}$')
          && (isAdmin() || compDoc().host == request.auth.uid || isModOf(compDoc())
              || exists(/databases/$(database)/documents/comps/$(code)/p/$(request.auth.uid)))
          && request.resource.data.keys().hasOnly(['u', 'n', 'x', 'ts'])
          && request.resource.data.u == request.auth.uid
          && request.resource.data.n is string && request.resource.data.n.size() <= 24
          && request.resource.data.x is string && request.resource.data.x.size() > 0 && request.resource.data.x.size() <= 200
          && request.resource.data.ts is timestamp
          && request.resource.data.ts > request.time - duration.value(120, 's')
          && request.resource.data.ts < request.time + duration.value(120, 's');
        allow delete: if request.auth != null && (request.auth.uid == resource.data.u || isAdmin()
          || get(/databases/$(database)/documents/comps/$(code)).data.host == request.auth.uid
          || isModOf(get(/databases/$(database)/documents/comps/$(code)).data));
      }

      // Canlı izleyiciler: her sayfa 20 sn'de bir kendi kaydının zamanını yazar ("X kişi izliyor")
      match /w/{vid} {
        allow read: if true;
        allow create, update: if beta() && vid.matches('^[A-Za-z0-9_-]{6,40}$')
          && request.resource.data.keys().hasOnly(['ts'])
          && request.resource.data.ts is timestamp
          && request.resource.data.ts > request.time - duration.value(120, 's')
          && request.resource.data.ts < request.time + duration.value(120, 's');
        allow delete: if isAdmin() || (request.auth != null && (request.auth.uid == vid
          || get(/databases/$(database)/documents/comps/$(code)).data.host == request.auth.uid));
      }
    }

    // Rekor tablosu (/icerikler/rekorlar): ev yarışması kişisel rekorları. Herkes okur; sahibi yazar (ms, 0 = yok)
    match /records/{uid} {
      function okT(f) { return request.resource.data[f] is int && request.resource.data[f] >= 0 && request.resource.data[f] < 3600000; }
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid && !suspended(uid)
        && request.resource.data.keys().hasOnly(['name', 's333', 'a5_333', 'a12_333', 's222', 'a5_222', 'a12_222', 'n', 'w', 'ts'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && okT('s333') && okT('a5_333') && okT('a12_333') && okT('s222') && okT('a5_222') && okT('a12_222')
        && request.resource.data.n is int && request.resource.data.w is int
        && request.resource.data.ts is timestamp;
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
    }

    // Topluluk algoritmaları: algsug/{case}/s/{uid}. Herkes okur; her üye bir case'e tek öneri (belge = uid).
    // Oy: vs haritasına yalnız kendi uid'ini ekler / çıkarır.
    match /algsug/{cid}/s/{sid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == sid && !suspended(sid) && cid.size() <= 400
        && request.resource.data.keys().hasOnly(['a', 'u', 'n', 'ts', 'vs'])
        && request.resource.data.u == sid
        && request.resource.data.a is string && request.resource.data.a.size() >= 1 && request.resource.data.a.size() <= 200
        && request.resource.data.n is string && request.resource.data.n.size() <= 24
        && request.resource.data.ts is timestamp
        && request.resource.data.vs is map && request.resource.data.vs.keys().hasOnly([sid]);
      allow update: if request.auth != null && !suspended(request.auth.uid)
        && request.resource.data.keys().hasOnly(['a', 'u', 'n', 'ts', 'vs'])
        && (
          (request.auth.uid == sid && request.resource.data.u == sid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['a', 'n', 'ts', 'u'])
            && request.resource.data.a is string && request.resource.data.a.size() >= 1 && request.resource.data.a.size() <= 200
            && request.resource.data.n is string && request.resource.data.n.size() <= 24)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vs'])
            && request.resource.data.vs.diff(resource.data.vs).affectedKeys().hasOnly([request.auth.uid]))
        );
      allow delete: if request.auth != null && (request.auth.uid == sid || isAdmin());
    }

    // Site ayarı (bakım modu): herkes okur, yalnız admin yazar
    // Hesapsız ziyaretçiler: cihaz başına tek belge (oturumda bir kez yazılır); yalnız admin okur/siler
    match /anon/{vid} {
      allow read, delete: if isAdmin();
      allow create, update: if vid.matches('^v[a-z0-9]{6,20}$')
        && request.resource.data.keys().hasOnly(['f', 'l', 'd', 's', 'p', 'dev'])
        && request.resource.data.l is int
        && request.resource.data.l > request.time.toMillis() - 600000
        && request.resource.data.l < request.time.toMillis() + 600000
        && request.resource.data.f is int && request.resource.data.f <= request.resource.data.l
        && request.resource.data.d is int && request.resource.data.d >= 1 && request.resource.data.d <= 100000
        && request.resource.data.s is int && request.resource.data.s >= 1 && request.resource.data.s <= 1000000
        && request.resource.data.p is string && request.resource.data.p.size() <= 120
        && request.resource.data.dev is string && request.resource.data.dev.size() <= 40;
    }

    match /config/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Herkese açık duyurular: yalnız admin yazar, herkes okur
    match /broadcasts/{id} {
      allow read: if true;
      allow create: if (isAdmin()
        && request.resource.data.keys().hasOnly(['text', 'ts', 'at', 'pushed'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 500)
        // Yeni ev yarışması duyurusu: yalnız oda sahibi, yarışma başına bir kez (belge adı comp-KOD)
        || (request.auth != null && id.matches('^comp-[A-Z0-9]{5}$')
          && get(/databases/$(database)/documents/comps/$(id.split('-')[1])).data.host == request.auth.uid
          && request.resource.data.keys().hasOnly(['text', 'ts', 'pushed'])
          && request.resource.data.text is string && request.resource.data.text.size() <= 200
          && request.resource.data.pushed == false && request.resource.data.ts is timestamp);
      allow update, delete: if isAdmin();
    }

    // Web Push abonelikleri: herkes kendi cihazını kaydeder (uid boş ya da kendisi); yalnız admin okur.
    // Gönderimi GitHub Actions'taki gönderici (hizmet hesabı) yapar.
    match /pushsubs/{id} {
      allow get, list: if isAdmin();
      allow delete: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create, update: if id.matches('^[a-f0-9]{32}$')
        && request.resource.data.keys().hasOnly(['sub', 'uid', 'rem', 'ts'])
        && (!('rem' in request.resource.data) || (request.resource.data.rem is string && request.resource.data.rem.size() <= 20))
        && request.resource.data.sub is string && request.resource.data.sub.size() <= 2000
        && request.resource.data.uid is string
        && (request.resource.data.uid == '' || (request.auth != null && request.auth.uid == request.resource.data.uid))
        && request.resource.data.ts is timestamp;
    }

    // Çekilişler (/icerikler/cekilis): yönetici kurar; kayıtlar çekilişten 24 saat önce kapanır.
    // Çekilişte rastgele seçilen kişi 2 dakika içinde onaylar, sonra teslimat bilgilerini gönderir.
    match /giveaways/{gid} {
      function gk() { return ['title', 'prize', 'desc', 'img', 'drawAt', 'closeAt', 'host', 'hName', 'st', 'w', 'wName', 'wAt', 'claimBy', 'cAt', 'x', 'n', 'ts']; }
      allow read: if true;
      allow create: if gwMgr() && gid.matches('^[A-Za-z0-9]{6,24}$')
        && request.resource.data.keys().hasOnly(gk())
        && request.resource.data.host == request.auth.uid
        && request.resource.data.st == 'open'
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
        && request.resource.data.prize is string && request.resource.data.prize.size() <= 120
        && request.resource.data.desc is string && request.resource.data.desc.size() <= 1500
        && request.resource.data.img is string && request.resource.data.img.size() <= 500
        && request.resource.data.drawAt is timestamp && request.resource.data.drawAt > request.time
        && request.resource.data.closeAt == request.resource.data.drawAt - duration.value(24, 'h');
      // yönetici her şeyi; kazanan yalnız 2 dakika içinde onaylar (st: drawn → claimed)
      allow update: if request.resource.data.keys().hasOnly(gk())
        && (gwMgr()
            || (request.auth != null && resource.data.st == 'drawn' && resource.data.w == request.auth.uid
                && request.time <= resource.data.claimBy
                && request.resource.data.st == 'claimed'
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'cAt'])));
      allow delete: if gwMgr();

      // Katılımcılar: üye kendini ekler/çıkarır (kayıtlar kapanana kadar); herkes sayıyı görür
      match /e/{uid} {
        allow read: if true;
        allow create: if request.auth != null && request.auth.uid == uid && !suspended(uid)
          && request.time < get(/databases/$(database)/documents/giveaways/$(gid)).data.closeAt
          && request.resource.data.keys().hasOnly(['name', 'ts'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 24
          && request.resource.data.ts == request.time;
        allow delete: if gwMgr() || (request.auth != null && request.auth.uid == uid
          && request.time < get(/databases/$(database)/documents/giveaways/$(gid)).data.closeAt);
        allow update: if false;
      }
      // Kazananın teslimat bilgileri: yalnız kazanan yazar (onayladıktan sonra), yalnız kazanan ve yöneticiler okur
      match /claim/{uid} {
        allow read: if gwMgr() || (request.auth != null && request.auth.uid == uid);
        allow create, update: if request.auth != null && request.auth.uid == uid
          && get(/databases/$(database)/documents/giveaways/$(gid)).data.w == uid
          && get(/databases/$(database)/documents/giveaways/$(gid)).data.st == 'claimed'
          && request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'city', 'district', 'address', 'zip', 'note', 'ts'])
          && request.resource.data.name is string && request.resource.data.name.size() > 1 && request.resource.data.name.size() <= 80
          && request.resource.data.phone is string && request.resource.data.phone.size() >= 7 && request.resource.data.phone.size() <= 25
          && request.resource.data.email is string && request.resource.data.email.size() <= 120
          && request.resource.data.city is string && request.resource.data.city.size() <= 40
          && request.resource.data.district is string && request.resource.data.district.size() <= 60
          && request.resource.data.address is string && request.resource.data.address.size() > 5 && request.resource.data.address.size() <= 400
          && request.resource.data.zip is string && request.resource.data.zip.size() <= 10
          && request.resource.data.note is string && request.resource.data.note.size() <= 300
          && request.resource.data.ts is timestamp;
        allow delete: if gwMgr();
      }
    }

    match /users/{uid}/{sub=**} {
      allow read: if isAdmin();
    }

    // Hata kayıtları: tarayıcıdaki JavaScript hataları (giriş gerekmez, yalnız ekleme). Yalnız admin okur/siler.
    match /errs/{id} {
      allow read, delete: if isAdmin();
      allow update: if false;
      allow create: if id.matches('^[a-z0-9]{8,24}$')
        && request.resource.data.keys().hasOnly(['m', 's', 'l', 'p', 'ua', 'u', 'v'])
        && request.resource.data.m is string && request.resource.data.m.size() > 0 && request.resource.data.m.size() <= 300
        && request.resource.data.s is string && request.resource.data.s.size() <= 200
        && request.resource.data.l is int
        && request.resource.data.p is string && request.resource.data.p.size() <= 120
        && request.resource.data.ua is string && request.resource.data.ua.size() <= 200
        && request.resource.data.u is string && request.resource.data.u.size() <= 40
        && request.resource.data.v is string && request.resource.data.v.size() <= 20;
    }

    // Geri bildirim / puan (ör. biten tema için 1-5 yıldız): herkes ekler, yalnız admin okur/siler
    match /feedback/{id} {
      allow read, delete: if isAdmin();
      allow update: if false;
      allow create: if id.matches('^[a-z0-9]{8,24}$')
        && request.resource.data.keys().hasOnly(['topic', 'stars', 'text', 'u', 'ts'])
        && request.resource.data.topic is string && request.resource.data.topic.size() > 0 && request.resource.data.topic.size() <= 40
        && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.text is string && request.resource.data.text.size() <= 300
        && request.resource.data.u is string
        && (request.resource.data.u == '' || (request.auth != null && request.resource.data.u == request.auth.uid))
        && request.resource.data.ts == request.time;
    }

    // Admin paneli: tüm algoritma önerilerini tek sorguda listeler (koleksiyon grubu "s")
    match /{path=**}/s/{sid} {
      allow read: if isAdmin();
    }

    // Küp Arena kulüpleri: kaClubs/{kod} (+ m: üyeler, c: sohbet, r: küp bağışı istekleri)
    match /kaClubs/{code} {
      function kaSigned() { return request.auth != null && !suspended(request.auth.uid); }
      function kaClub() { return get(/databases/$(database)/documents/kaClubs/$(code)).data; }
      function kaMember() { return exists(/databases/$(database)/documents/kaClubs/$(code)/m/$(request.auth.uid)); }
      function kaOk(d) {
        return d.keys().hasOnly(['name', 'desc', 'badge', 'owner', 'oName', 'ts'])
          && d.name is string && d.name.size() >= 2 && d.name.size() <= 24
          && d.desc is string && d.desc.size() <= 120
          && d.badge is int && d.badge >= 0 && d.badge <= 11
          && d.owner is string && d.oName is string && d.oName.size() <= 24;
      }
      allow read: if true;
      allow create: if kaSigned() && code.matches('^[A-Z0-9]{6}$') && kaOk(request.resource.data)
        && request.resource.data.owner == request.auth.uid && request.resource.data.ts == request.time;
      allow update: if kaSigned() && resource.data.owner == request.auth.uid && kaOk(request.resource.data);
      allow delete: if request.auth != null && (resource.data.owner == request.auth.uid || isAdmin());

      match /m/{uid} {
        allow read: if true;
        allow create, update: if kaSigned() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'lvl', 'tr', 'title', 'w', 'wk', 'ts'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 24
          && request.resource.data.lvl is int && request.resource.data.tr is int
          && request.resource.data.w is int && request.resource.data.w >= 0 && request.resource.data.w <= 5000
          && request.resource.data.wk is int
          && request.resource.data.title is string && request.resource.data.title.size() <= 24
          && request.resource.data.ts == request.time;
        allow delete: if request.auth != null && (request.auth.uid == uid || kaClub().owner == request.auth.uid || isAdmin());
      }

      match /c/{mid} {
        allow read: if request.auth != null && (kaMember() || isAdmin());
        allow create: if kaSigned() && kaMember() && mid.matches('^[a-z0-9]{6,24}$')
          && request.resource.data.keys().hasOnly(['u', 'n', 'x', 'ts'])
          && request.resource.data.u == request.auth.uid
          && request.resource.data.n is string && request.resource.data.n.size() <= 24
          && request.resource.data.x is string && request.resource.data.x.size() > 0 && request.resource.data.x.size() <= 200
          && request.resource.data.ts == request.time;
        allow delete: if request.auth != null && (resource.data.u == request.auth.uid || kaClub().owner == request.auth.uid || isAdmin());
        allow update: if false;
      }

      // Bağış isteği: belge = isteyen üyenin uid'i. Diğer üyeler got'u 1 artırır ve gv'ye kendi uid'ini ekler (istek başına bir kez).
      match /r/{uid} {
        allow read: if true;
        allow create: if kaSigned() && request.auth.uid == uid && kaMember()
          && request.resource.data.keys().hasOnly(['cube', 'name', 'need', 'got', 'gv', 'ts'])
          && request.resource.data.cube is string && request.resource.data.cube.matches('^[a-z0-9]{1,8}$')
          && request.resource.data.name is string && request.resource.data.name.size() <= 24
          && request.resource.data.need is int && request.resource.data.need >= 1 && request.resource.data.need <= 5
          && request.resource.data.got == 0 && request.resource.data.gv == {}
          && request.resource.data.ts == request.time;
        allow update: if kaSigned() && kaMember() && request.auth.uid != uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['got', 'gv'])
          && request.resource.data.got == resource.data.got + 1
          && request.resource.data.got <= resource.data.need
          && request.resource.data.gv.diff(resource.data.gv).affectedKeys().hasOnly([request.auth.uid])
          && !(request.auth.uid in resource.data.gv);
        allow delete: if request.auth != null && (request.auth.uid == uid || kaClub().owner == request.auth.uid || isAdmin());
      }
    }

    // Küp Arena takasları: kaTrades/{kod}. open → accepted (karşı taraf) → done (teklif sahibi); open → cancel (teklif sahibi)
    match /kaTrades/{code} {
      function ktSigned() { return request.auth != null && !suspended(request.auth.uid); }
      function ktKeys() { return ['from', 'fName', 'club', 'give', 'want', 'st', 'by', 'bName', 'ts']; }
      function ktChg() { return request.resource.data.diff(resource.data).affectedKeys(); }
      allow read: if true;
      allow create: if ktSigned() && code.matches('^[A-Z0-9]{6}$')
        && request.resource.data.keys().hasOnly(ktKeys())
        && request.resource.data.from == request.auth.uid
        && request.resource.data.fName is string && request.resource.data.fName.size() <= 24
        && request.resource.data.club is string && request.resource.data.club.size() <= 6
        && request.resource.data.give is string && request.resource.data.give.matches('^[a-z0-9]{1,8}$')
        && request.resource.data.want is string && request.resource.data.want.matches('^[a-z0-9]{1,8}$')
        && request.resource.data.give != request.resource.data.want
        && request.resource.data.st == 'open' && request.resource.data.by == '' && request.resource.data.bName == ''
        && request.resource.data.ts == request.time;
      allow update: if ktSigned() && request.resource.data.keys().hasOnly(ktKeys()) && (
          (resource.data.st == 'open' && request.resource.data.st == 'accepted'
            && request.resource.data.by == request.auth.uid && request.auth.uid != resource.data.from
            && request.resource.data.bName is string && request.resource.data.bName.size() <= 24
            && ktChg().hasOnly(['st', 'by', 'bName']))
          || (resource.data.from == request.auth.uid && resource.data.st == 'accepted'
            && request.resource.data.st == 'done' && ktChg().hasOnly(['st']))
          || (resource.data.from == request.auth.uid && resource.data.st == 'open'
            && request.resource.data.st == 'cancel' && ktChg().hasOnly(['st'])));
      allow delete: if request.auth != null && (resource.data.from == request.auth.uid || isAdmin());
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
