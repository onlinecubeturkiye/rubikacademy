/* =========================================
   RENKLER (KIRMIZI / BEYAZ TEMA)
========================================= */

:root {
  --background: #f8fafc;
  --surface: #ffffff;
  --surface-soft: #f1f5f9;
  --primary: #e6252f;
  --primary-dark: #b91c1c;
  --primary-light: #fef2f2;
  --text: #172033;
  --text-soft: #64748b;
  --border: #f0d9db;
  --shadow: 0 15px 40px rgba(15, 23, 42, 0.07);
}

.bg-glow {
  position: fixed;
  top: 0; left: 0;
  width: 100vw; height: 100vh;
  overflow: hidden;
  z-index: -999;
  pointer-events: none;
}
.bg-glow::before, .bg-glow::after {
  content: "";
  position: absolute;
  width: 500px; height: 500px;
  border-radius: 50%;
  filter: blur(120px);
  opacity: 0.16;
  animation: floatGlow 15s infinite alternate ease-in-out;
}
.bg-glow::before { background: #e6252f; top: -100px; left: -100px; }
.bg-glow::after { background: #b91c1c; bottom: -100px; right: -100px; animation-delay: -7s; }
@keyframes floatGlow {
  0% { transform: translate(0px, 0px) scale(1); }
  100% { transform: translate(150px, 200px) scale(1.25); }
}

* { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; overflow-x: hidden; width: 100%; }
body {
  font-family: "Inter", sans-serif;
  background: var(--background);
  color: var(--text);
  overflow-x: hidden;
  width: 100%;
  transition: background-color 0.3s ease, color 0.3s ease;
}
a { text-decoration: none; color: inherit; }

/* =========================================
   ÜST BAR
========================================= */

.navbar {
  position: sticky; top: 0; z-index: 1000;
  display: flex; align-items: center; justify-content: space-between;
  padding: 16px 7%;
  background: rgba(248, 250, 252, 0.85);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
  transition: background-color 0.3s, border-color 0.3s;
}
.nav-left { display: flex; align-items: center; gap: 16px; }
.back-btn {
  display: flex; align-items: center; gap: 7px;
  height: 38px; padding: 0 16px 0 12px; border-radius: 20px;
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: #fff; font-size: 13px; font-weight: 700;
  flex-shrink: 0; transition: .25s;
  box-shadow: 0 8px 18px rgba(230,37,47,.28);
}
.back-btn svg { width: 17px; height: 17px; flex-shrink: 0; }
.back-btn:hover { transform: translateX(-3px); box-shadow: 0 10px 22px rgba(230,37,47,.36); }
@media(max-width:500px) {
  .back-btn span { display: none; }
  .back-btn { padding: 0; width: 38px; justify-content: center; }
}
.nav-logo { display: flex; align-items: center; gap: 12px; }
.nav-logo-mark {
  width: 38px; height: 38px;
  border-radius: 10px;
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  box-shadow: 0 8px 18px rgba(230,37,47,.25);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.nav-logo-mark svg { width: 26px; height: 26px; }
.nav-logo-text { font-size: 17px; font-weight: 800; letter-spacing: -0.5px; color: var(--text); }

.nav-right { display: flex; align-items: center; gap: 10px; }
.nav-links { display: flex; align-items: center; gap: 8px; }
.nav-links a { padding: 9px 16px; border-radius: 10px; font-size: 14px; font-weight: 600; color: var(--text-soft); transition: .25s; }
.nav-links a:hover, .nav-links a.active { background: var(--primary-light); color: var(--primary); }

@media(max-width:500px) {
