html.dark-mode body, body.dark-mode { background: var(--background); color: var(--text); }
html.dark-mode .navbar, body.dark-mode .navbar { background: rgba(15, 23, 42, 0.90); }
html.dark-mode .competition-card, body.dark-mode .competition-card,
html.dark-mode .competitions-empty, body.dark-mode .competitions-empty,
html.dark-mode footer, body.dark-mode footer { background: var(--surface); }
html.dark-mode .competition-card, body.dark-mode .competition-card {
