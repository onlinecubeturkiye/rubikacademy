  gap: 30px;
  padding: 36px 40px;
  border-radius: 26px;
  background: var(--surface);
  border: 2px solid var(--primary);
  box-shadow: 0 0 0 4px rgba(230,37,47,.10), 0 24px 55px rgba(230,37,47,.16);
  transition: .3s;
}
.competition-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 0 0 5px rgba(230,37,47,.14), 0 28px 60px rgba(230,37,47,.22);
}

.competition-body { min-width: 0; }
.competition-status {
