.lang-menu {
  position: absolute; top: calc(100% + 10px); right: 0; min-width: 168px;
  background: var(--surface); border: 1px solid var(--border); border-radius: 16px; box-shadow: var(--shadow);
  padding: 7px; display: flex; flex-direction: column; gap: 3px;
  opacity: 0; visibility: hidden; transform: translateY(-8px); transition: .2s ease; z-index: 1100;
}
.lang-menu.open { opacity: 1; visibility: visible; transform: translateY(0); }
.lang-menu-item {
  display: flex; align-items: center; gap: 10px; border: none; background: transparent; color: var(--text);
  text-align: left; padding: 10px 14px; border-radius: 11px; font-size: 14px; font-weight: 600; cursor: pointer;
  transition: .2s; width: 100%;
}
.lang-menu-item:hover { background: var(--primary-light); color: var(--primary); }
.lang-menu-item.active { background: var(--primary-light); color: var(--primary); font-weight: 800; }
.lang-menu-item .lang-check { margin-left: auto; font-size: 12px; opacity: 0; }
.lang-menu-item.active .lang-check { opacity: 1; }

/* Karanlık mod renkleri */
html.dark-mode, body.dark-mode {
  --background: #0f172a;
  --surface: #1e293b;
  --surface-soft: #334155;
  --text: #f8fafc;
  --text-soft: #cbd5e1;
  --border: #3f2329;
  --primary-light: #4c1116;
