.page-head p { max-width: 600px; margin: 0 auto; color: var(--text-soft); font-size: 17px; line-height: 1.75; }

/* =========================================
   YARIŞMA LİSTESİ
========================================= */

.competitions { padding: 60px 7% 120px; }
.competitions-inner { max-width: 900px; margin: auto; display: flex; flex-direction: column; gap: 22px; }

.competition-card {
